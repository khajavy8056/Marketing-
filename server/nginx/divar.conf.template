# پیکربندی Nginx نسخهٔ سرور — مسیر /remote/ و پنل پشت احراز هویت برنامه.
# جای‌گذاری‌ها: {{SERVER_NAME}} ، {{SSL_CERT}} ، {{SSL_KEY}}
server {
    listen 80;
    server_name {{SERVER_NAME}};

    # برای Let's Encrypt (certbot --nginx خودش این‌ها را اضافه می‌کند)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:8642;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ارتقای WebSocket (برای noVNC /remote/.../ws)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 20m;
    }
}

# بلوک HTTPS (بعد از دریافت گواهی Let's Encrypt فعال می‌شود)
server {
    listen 443 ssl http2;
    server_name {{SERVER_NAME}};
    ssl_certificate {{SSL_CERT}};
    ssl_certificate_key {{SSL_KEY}};

    location / {
        proxy_pass http://127.0.0.1:8642;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 20m;
    }
}
